FROM python:3.12-slim

ARG LITESTREAM_VERSION=0.5.12
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-amd64.tar.gz" \
       | tar -xz -C /usr/local/bin \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
COPY cloudflare/litestream.yml /etc/litestream.yml
RUN chmod +x cloudflare/start.sh

ENV PRO_DATA_DIR=/data/genmar-pro
EXPOSE 8080
CMD ["./cloudflare/start.sh"]
